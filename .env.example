# Kaggle API credentials (only needed if you re-download the raw dataset
# via the Kaggle API instead of the manual download used in this project -
# see scripts/download_dataset.py).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Database connection. Defaults to local SQLite if unset - see
# backend/app/db/database.py. For a production PostgreSQL+PostGIS setup
# (see docker-compose.yml), set e.g.:
# DATABASE_URL=postgresql://omniwatch:omniwatch@localhost:5432/omniwatch
DATABASE_URL=

# Frontend -> backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api
